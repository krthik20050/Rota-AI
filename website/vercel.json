{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/download",
      "destination": "/#download",
      "permanent": true
    },
    {
      "source": "/github",
      "destination": "https://github.com/krthik20050/rota-ai",
      "permanent": true
    },
    {
      "source": "/discord",
      "destination": "https://discord.gg/rota-ai",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
